[req]
default_bits = 2048
prompt = no
default_md = sha256
req_extensions = req_ext
distinguished_name = dn

[dn]
C=IN
ST=Delhi
L=Delhi
O=DevOps
CN=vault.local

[req_ext]
subjectAltName = @alt_names

[alt_names]
DNS.1 = vault.local
DNS.2 = localhost
IP.1 = 127.0.0.1
IP.2 = 0.0.0.0
