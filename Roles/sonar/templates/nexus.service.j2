[Unit]
Description=Nexus Repository Manager
After=network.target

[Service]
Type=forking
LimitNOFILE=65536
ExecStart={{ nexus_install_dir }}-{{ nexus_version }}/bin/nexus start
ExecStop={{ nexus_install_dir }}-{{ nexus_version }}/bin/nexus stop
User={{ nexus_user }}
Group={{ nexus_group }}
Restart=on-abort

[Install]
WantedBy=multi-user.target
