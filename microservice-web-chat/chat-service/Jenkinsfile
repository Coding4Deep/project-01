pipeline {
    agent any

    environment {
        ECR_REPO = '286549082566.dkr.ecr.us-east-1.amazonaws.com/webchat-app/chat-service'
        DOCKER_REPO = "deepaksag/webchat-app"
        IMAGE_NAME = 'chat-service'
        IMAGE_TAG = "chat-v1.0.0"
        AWS_ACCESS_KEY_ID = credentials('awscreds')
        AWS_SECRET_ACCESS_KEY = credentials('awscreds')
        AWS_REGION = 'us-east-1'
        CI = 'false'
    }
    
    tools {
        nodejs 'NodeJS-18'
    }

    stages {
        stage('Check Node') {
            steps {
                sh 'node --version'
                sh 'npm --version'
            }
        }
        
        stage('Checkout') {
            steps {
                git branch: 'spring', url: 'https://github.com/Coding4Deep/project-01.git'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('microservice-web-chat/chat-service') {
                    sh 'npm install'
                }
            }
        }

        stage('Run Unit Tests') {
            steps {
                dir('microservice-web-chat/chat-service') {
                    script {
                        try {
                            sh 'CI=true npm test -- --watchAll=false --passWithNoTests'
                        } catch (Exception e) {
                            echo "Tests failed but continuing: ${e.getMessage()}"
                            currentBuild.result = 'UNSTABLE'
                        }
                    }
                }
            }
            post {
                always {
                    dir('microservice-web-chat/chat-service') {
                        echo 'Tests completed'
                        archiveArtifacts artifacts: 'coverage/**/*', allowEmptyArchive: true
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('microservice-web-chat/chat-service') {
                    script {
                        try {
                            withSonarQubeEnv('MySonarQube') {
                                sh """
                                    \${SONAR_SCANNER_HOME}/bin/sonar-scanner \
                                    -Dsonar.projectKey=webchat-chat-service \
                                    -Dsonar.projectName="WebChat Chat Service" \
                                    -Dsonar.projectVersion=1.0.0 \
                                    -Dsonar.sources=. \
                                    -Dsonar.exclusions=node_modules/**,coverage/**,test/** \
                                    -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info
                                """
                            }
                            echo "SonarQube analysis completed successfully"
                        } catch (Exception e) {
                            echo "SonarQube analysis failed: ${e.getMessage()}"
                            echo "Continuing pipeline without SonarQube analysis"
                        }
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('microservice-web-chat/chat-service') {
                    echo "Building Docker image..."
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Push Docker Image to Docker Hub') {
            steps {
                dir('microservice-web-chat/chat-service') {
                    withCredentials([
                        usernamePassword(
                            credentialsId: 'docker-hub-credentials', 
                            usernameVariable: 'DOCKERHUB_USERNAME', 
                            passwordVariable: 'DOCKERHUB_PASSWORD'
                        )
                    ]) {
                        sh """
                            echo \$DOCKERHUB_PASSWORD | docker login -u \$DOCKERHUB_USERNAME --password-stdin
                            docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${DOCKER_REPO}:${IMAGE_TAG}
                            docker push ${DOCKER_REPO}:${IMAGE_TAG}
                        """
                    }
                }       
            }
        }

        // stage('Push Docker Image to AWS ECR') {
        //     steps {
        //         dir('microservice-web-chat/chat-service') {
        //             withAWS(credentials: 'awscreds', region: "${AWS_REGION}") {
        //                 sh """
        //                     aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin 286549082566.dkr.ecr.us-east-1.amazonaws.com
        //                     docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${ECR_REPO}:${IMAGE_TAG}
        //                     docker push ${ECR_REPO}:${IMAGE_TAG}
        //                 """
        //             }
        //         }
        //     }
        // }
    }

    post {
        always {
            dir('microservice-web-chat/chat-service') {
               echo "Cleaning up Docker images..."
               sh "docker image prune -af || true"
            }
        }
        success {
            echo "Pipeline completed successfully!"
        }
        unstable {
            echo "Pipeline completed but with some issues"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
